{
  "name": "pigment-shop",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.3",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.6",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "zod": "^3.23.8"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backup": "node .tools/core/backuper/backup.js",
    "restore": "node .tools/core/backuper/restore.js",
    "audit": "node .tools/auditors/ui-auditor/fallow-auditor/run-audit.cjs",
    "audit:ui": "node .tools/auditors/ui-auditor/index.js",
    "audit:dynamic": "npx tsx .tools/automation/browser-automation/run-dynamic-audit.ts",
    "smoke:mocks": "npx tsx .tools/automation/browser-automation/run-smoke-mocks.ts",
    "clean": "node .tools/core/cleaner/run-clean.cjs",
    "health": "node .tools/core/health/run-health.cjs",
    "pack": "node .tools/core/packer/run-pack.cjs",
    "generate-media": "node .tools/scripts/generateMediaManifest.js",
    "regenerate-database": "node .tools/scripts/regenerateDatabase.js",
    "regenerate-database-low": "node .tools/scripts/regenerateDatabase.js --low",
    "type-check": "tsc --noEmit"
  },
  "mediaConfig": {
    "scanSubdirectories": true
  },
  "private": true,
  "devDependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.4",
    "expo-av": "~15.0.2",
    "expo-video": "~2.0.5",
    "playwright": "^1.61.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
