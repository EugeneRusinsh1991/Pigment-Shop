{
  "patterns": [
    {
      "name": "BORDER_WIDTH",
      "description": "Хардкод ширины границ",
      "patterns": [
        { "regex": "\\bborderWidth\\s*:\\s*(\\d+)", "example": "borderWidth: 1" },
        { "regex": "\\bborder(?:Top|Bottom|Left|Right)?Width\\s*:\\s*(\\d+)", "example": "borderTopWidth: 2" }
      ],
      "excludeFiles": ["tokens.js", "theme.js", "styles.js"]
    },
    {
      "name": "BORDER_COLOR",
      "description": "Хардкод цветов границ",
      "patterns": [
        { "regex": "\\bborderColor\\s*:\\s*['\"]\\w+['\"]", "example": "borderColor: \"white\"" },
        { "regex": "\\bborder(?:Top|Bottom|Left|Right)?Color\\s*:\\s*['\"]\\w+['\"]", "example": "borderTopColor: \"black\"" }
      ],
      "excludeFiles": ["tokens.js", "theme.js", "colors.js"]
    },
    {
      "name": "BORDER_RADIUS",
      "description": "Хардкод радиуса границ",
      "patterns": [
        { "regex": "\\bborderRadius\\s*:\\s*(\\d+)", "example": "borderRadius: 8" }
      ],
      "excludeFiles": ["tokens.js", "theme.js"]
    },
    {
      "name": "MARGIN_PADDING",
      "description": "Хардкод отступов",
      "patterns": [
        { "regex": "\\b(margin|padding)(?:Top|Bottom|Left|Right|Vertical|Horizontal)?\\s*:\\s*(\\d+)", "example": "margin: 10" }
      ],
      "excludeFiles": ["tokens.js", "theme.js"]
    },
    {
      "name": "COLOR_HEX",
      "description": "Хардкод HEX цветов",
      "patterns": [
        { "regex": "#(?:[0-9a-fA-F]{3}){1,2}\\b", "example": "#ffffff" }
      ],
      "excludeFiles": ["tokens.js", "theme.js", "colors.js"]
    },
    {
      "name": "COLOR_RGB",
      "description": "Хардкод RGB/RGBA цветов",
      "patterns": [
        { "regex": "rgba?\\([^)]+\\)", "example": "rgba(0,0,0,0.5)" }
      ],
      "excludeFiles": ["tokens.js", "theme.js", "colors.js"]
    },
    {
      "name": "FONT_SIZE",
      "description": "Хардкод размера шрифта",
      "patterns": [
        { "regex": "\\bfontSize\\s*:\\s*(\\d+)", "example": "fontSize: 16" }
      ],
      "excludeFiles": ["tokens.js", "theme.js", "typography.js"]
    },
    {
      "name": "FONT_WEIGHT",
      "description": "Хардкод веса шрифта",
      "patterns": [
        { "regex": "\\bfontWeight\\s*:\\s*['\"]?\\d+['\"]?", "example": "fontWeight: 700" }
      ],
      "excludeFiles": ["tokens.js", "theme.js", "typography.js"]
    },
    {
      "name": "Z_INDEX",
      "description": "Хардкод z-index",
      "patterns": [
        { "regex": "\\bzIndex\\s*:\\s*(\\d{2,})", "example": "zIndex: 999" }
      ],
      "excludeFiles": ["tokens.js", "theme.js"]
    },
    {
      "name": "OPACITY",
      "description": "Хардкод прозрачности",
      "patterns": [
        { "regex": "\\bopacity\\s*:\\s*[0-9.]+", "example": "opacity: 0.5" }
      ],
      "excludeFiles": ["tokens.js", "theme.js"]
    }
  ]
}
